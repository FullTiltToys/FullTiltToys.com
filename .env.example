# Import in Vercel: Project → Settings → Environment Variables → Import .env
# Apply to Production, Preview, and Development, then Redeploy.

# Inbox that should receive Wholesale form submissions.
WHOLESALE_TO_EMAIL=info@fulltilttoys.com

# Free access key from https://web3forms.com (create it with info@fulltilttoys.com).
# Required on Vercel for live Wholesale emails. Do not commit the real key.
WEB3FORMS_ACCESS_KEY=

# Google Apps Script web app URL for the email list (optional; form is currently hidden).
# Paste the https://script.google.com/macros/s/…/exec URL after the equals sign. Do not share it.
GOOGLE_SHEETS_WEBHOOK_URL=
